{
  "hooks": {
    "PreToolUse": [{ "matcher": "^Bash$", "hooks": [
      { "type": "command", "command": "python3 \"$HOME/.codex/hooks/run_hook.py\" guard" }
    ] }],
    "PostToolUse": [{ "matcher": "^(apply_patch|Edit|Write)$", "hooks": [
      { "type": "command", "command": "python3 \"$HOME/.codex/hooks/run_hook.py\" after", "timeout": 120 }
    ] }],
    "Stop": [{ "hooks": [
      { "type": "command", "command": "python3 \"$HOME/.codex/hooks/run_hook.py\" stop", "timeout": 130 }
    ] }]
  }
}
